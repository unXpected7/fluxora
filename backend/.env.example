NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
STAFF_CLIENT_ORIGIN=http://localhost:5173
STAFF_INVITATION_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://fluxora:fluxora_local_dev@localhost:5439/fluxora_eticket

# Keep disabled until the sandbox merchant QRIS ID and callback flow are validated.
CHECKOUT_PAYMENT_PROVIDER=disabled
RAJAONGKIR_PAYMENT_API_KEY=
RAJAONGKIR_QRIS_API_KEY=
RAJAONGKIR_QRIS_ID=
RAJAONGKIR_API_BASE_URL=
TICKET_QR_SIGNING_SECRET=

# Optional transactional ticket delivery through Brevo. When unset, paid tickets
# remain available through the private order endpoint and email stays queued.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Fluxora Tickets
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_SANDBOX=false

# Required to create/sign partner webhook subscriptions (base64-encoded 32 random bytes).
PARTNER_WEBHOOK_ENCRYPTION_KEY=
