# Store these in /home/vm01/fluxora/postgres/.env on vm01 only (chmod 600).
# Use unique random passwords; hex secrets are safe to place in PostgreSQL URLs.
FLUXORA_DEV_POSTGRES_DB=fluxora_eticket_dev
FLUXORA_DEV_POSTGRES_USER=fluxora_eticket_dev
FLUXORA_DEV_POSTGRES_PASSWORD=replace-with-a-unique-random-secret
FLUXORA_DEV_DATABASE_URL=postgresql://fluxora_eticket_dev:replace-with-a-unique-random-secret@fluxora-eticket-postgres-dev:5432/fluxora_eticket_dev?schema=public
FLUXORA_PROD_POSTGRES_DB=fluxora_eticket_prod
FLUXORA_PROD_POSTGRES_USER=fluxora_eticket_prod
FLUXORA_PROD_POSTGRES_PASSWORD=replace-with-a-different-unique-random-secret
FLUXORA_PROD_DATABASE_URL=postgresql://fluxora_eticket_prod:replace-with-a-different-unique-random-secret@fluxora-eticket-postgres-prod:5432/fluxora_eticket_prod?schema=public
