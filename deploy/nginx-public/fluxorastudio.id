server {
    listen 80;
    server_name fluxorastudio.id www.fluxorastudio.id;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name fluxorastudio.id www.fluxorastudio.id;
    ssl_certificate /etc/letsencrypt/live/fluxorastudio.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fluxorastudio.id/privkey.pem;
    location / {
        proxy_pass http://10.10.0.2:8094;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
